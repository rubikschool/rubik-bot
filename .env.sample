TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Optional: set to force webhook mode (e.g. via ngrok). Leave empty for polling (local dev).
# WEBHOOK_URL=https://your-service.run.app

# Bot mode:
# "group"   - reply only in allowed groups (default)
# "private" - reply only in direct messages
# "both"    - reply in both groups and DMs
BOT_MODE=private
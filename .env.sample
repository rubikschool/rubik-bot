TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Optional: set to force webhook mode (e.g. via ngrok). Leave empty for polling (local dev).
# WEBHOOK_URL=https://your-service.run.app

# Режим работы бота: 
# "group"   - отвечает только в разрешенных группах (по умолчанию)
# "private" - отвечает только в личных сообщениях
# "both"    - отвечает и там, и там
BOT_MODE=private